{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "request.schema.json",
  "title": "Client request",
  "description": "Any message a client sends. Discriminated by `op`.",
  "oneOf": [
    { "$ref": "#/definitions/helloRequest" },
    { "$ref": "#/definitions/getRequest" },
    { "$ref": "#/definitions/setRequest" },
    { "$ref": "#/definitions/addRequest" },
    { "$ref": "#/definitions/resetRequest" },
    { "$ref": "#/definitions/subscribeRequest" },
    { "$ref": "#/definitions/unsubscribeRequest" }
  ],
  "definitions": {
    "id": {
      "type": "integer",
      "description": "Optional client-chosen correlation id, echoed in the reply."
    },
    "stack": {
      "$ref": "offset.schema.json#/definitions/stackId"
    },
    "helloRequest": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "op": { "const": "hello" }
      },
      "required": ["op"],
      "additionalProperties": false
    },
    "getRequest": {
      "description": "Read the user offset or a stack (/space/offset[/field] + optional stack), the total, or the stack list.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": { "$ref": "#/definitions/id" },
            "op": { "const": "get" },
            "path": {
              "anyOf": [
                { "$ref": "offset.schema.json#/definitions/offsetPath" },
                { "$ref": "offset.schema.json#/definitions/offsetFieldPath" }
              ]
            },
            "stack": { "$ref": "#/definitions/stack" }
          },
          "required": ["op", "path"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": { "$ref": "#/definitions/id" },
            "op": { "const": "get" },
            "path": {
              "anyOf": [
                { "$ref": "offset.schema.json#/definitions/totalPath" },
                { "$ref": "offset.schema.json#/definitions/totalFieldPath" },
                { "$ref": "offset.schema.json#/definitions/stacksPath" }
              ]
            }
          },
          "required": ["op", "path"],
          "additionalProperties": false
        }
      ]
    },
    "writeCommon": {
      "description": "Optional fields shared by set/add. `persist`, `gravity` and `floor` are only allowed together with `stack`; when omitted, an existing stack keeps its setting and a new one gets the default (persist false, gravity false, floor 0). `frame` is only allowed on `add` (checked by the server: bad_value).",
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "op": { "type": "string" },
        "stack": { "$ref": "#/definitions/stack" },
        "persist": { "type": "boolean" },
        "gravity": { "type": "boolean" },
        "floor": { "$ref": "offset.schema.json#/definitions/metersInput" },
        "pivot": { "$ref": "offset.schema.json#/definitions/pivot" },
        "frame": { "$ref": "offset.schema.json#/definitions/frame" }
      },
      "dependencies": {
        "persist": ["stack"],
        "gravity": ["stack"],
        "floor": ["stack"]
      }
    },
    "writeRequest": {
      "description": "Shared shape of set/add. Whole-object path takes a partial offset; field path takes a number. With `stack` the write targets that stack (created on first write), otherwise the user's offset.",
      "allOf": [
        { "$ref": "#/definitions/writeCommon" },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "id": true, "op": true, "stack": true, "persist": true, "gravity": true, "floor": true, "pivot": true, "frame": true,
                "path": { "$ref": "offset.schema.json#/definitions/offsetPath" },
                "value": { "$ref": "offset.schema.json#/definitions/partialOffset" }
              },
              "required": ["op", "path", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": true, "op": true, "stack": true, "persist": true, "gravity": true, "floor": true, "pivot": true, "frame": true,
                "path": { "$ref": "offset.schema.json#/definitions/offsetFieldPath" },
                "value": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000,
                  "description": "Meters for x/y/z (limited to ±10000), degrees for rotation (±1000000)."
                }
              },
              "required": ["op", "path", "value"],
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "setRequest": {
      "description": "Set offsets to absolute values.",
      "allOf": [
        { "$ref": "#/definitions/writeRequest" },
        { "properties": { "op": { "const": "set" } } }
      ]
    },
    "addRequest": {
      "description": "Add relative deltas to the current offsets.",
      "allOf": [
        { "$ref": "#/definitions/writeRequest" },
        { "properties": { "op": { "const": "add" } } }
      ]
    },
    "resetRequest": {
      "description": "With `stack`: remove that stack (its contribution drops to zero; resetting a missing stack is not an error). Without `stack`: zero the user's offset, like the Reset Offsets button; stacks are kept.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "op": { "const": "reset" },
        "path": { "$ref": "offset.schema.json#/definitions/offsetPath" },
        "stack": { "$ref": "#/definitions/stack" }
      },
      "required": ["op", "path"],
      "additionalProperties": false
    },
    "subscribablePath": {
      "anyOf": [
        { "$ref": "offset.schema.json#/definitions/offsetPath" },
        { "$ref": "offset.schema.json#/definitions/totalPath" },
        { "$ref": "offset.schema.json#/definitions/stacksPath" }
      ]
    },
    "subscribeRequest": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "op": { "const": "subscribe" },
        "path": { "$ref": "#/definitions/subscribablePath" }
      },
      "required": ["op", "path"],
      "additionalProperties": false
    },
    "unsubscribeRequest": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "op": { "const": "unsubscribe" },
        "path": { "$ref": "#/definitions/subscribablePath" }
      },
      "required": ["op", "path"],
      "additionalProperties": false
    }
  }
}
